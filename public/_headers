# Cross-origin isolation is required for SharedArrayBuffer (multithread engine).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# Engine artifacts live under versioned paths (/engine/<release>/...), so they never change in place.
/engine/*
  Cache-Control: public, max-age=31536000, immutable

# Catalog packs are content-hashed (<id>.<sha8>.json under a pinned Orca tag), so they never change in place.
# index.json and custom-base.json stay revalidated on purpose: they are the only mutable catalog entry points.
/catalog/:tag/printers/*
  Cache-Control: public, max-age=31536000, immutable
