# Cross-origin isolation is required for SharedArrayBuffer (multithread engine).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# Engine artifacts live under versioned paths (/engine/<release>/...), so they never change in place.
/engine/*
  Cache-Control: public, max-age=31536000, immutable

# Catalog packs are content-hashed (<id>.<sha8>.json under a pinned Orca tag), so they never change in place.
# index.json and custom-base.json stay revalidated on purpose: they are the only mutable catalog entry points.
/catalog/:tag/printers/*
  Cache-Control: public, max-age=31536000, immutable

# Vite content-hashes every chunk filename, so built assets never change in place either.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script itself, the shell document, and the two other mutable entry points
# (manifest, engine manifest) must always be revalidated so a new deploy is picked up promptly:
# the update flow (src/pwa/register.ts) depends on `sw.js` and `index.html` never being served stale.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/engine-manifest.json
  Cache-Control: no-cache
