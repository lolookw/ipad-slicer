{
  "name": "ipad-slicer",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: OrcaSlicer engine (OrcaWasm) slicing STL files client-side in iPad Safari",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('LICENSE', 'dist/LICENSE')\"",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "check-deploy": "node scripts/check-deploy.mjs",
    "slice-check": "node scripts/slice-check.mjs",
    "slice-check:mt": "node scripts/slice-check.mjs --variant mt",
    "prebuild": "npm run fetch-engine",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve:dist": "node scripts/serve-dist.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.20.3",
    "jsdom": "^28.1.0",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
